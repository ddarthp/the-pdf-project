<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="the_pdf_project"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

    <!-- The scanner takes a picture with whatever camera app is installed
         (MediaStore.ACTION_IMAGE_CAPTURE), writing the photo to our own
         FileProvider. On Android 11+ the plugin has to look that camera app up
         to grant it write access to the output file, and package-visibility
         filtering hides it without this declaration. See
         https://developer.android.com/training/package-visibility. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>

    <!-- Deliberately no <uses-permission> entries.

         android.permission.CAMERA is NOT declared: handing the capture to
         another camera app needs no permission of ours, and image_picker asks
         for CAMERA at runtime only when it finds the permission in the merged
         manifest (ImagePickerUtils.needRequestCameraPermission), so declaring
         it would add a prompt the app does not need.

         READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE are NOT declared either:
         pictures arrive through the system photo picker or the document
         picker, which hand back only what the user chose. Files are opened and
         saved the same way, through the system file picker.

         Nothing here talks to the network, so the shipped app has no INTERNET
         permission; the debug and profile manifests add it for hot reload and
         it does not merge into a release build.

         The camera is optional hardware — no <uses-feature> requirement, so
         the app still installs on a device without one. -->
</manifest>
